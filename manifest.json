{
  "manifest_version": 3,
  "name": "Harvest X",
  "version": "1.0.0",
  "description": "Exports your X bookmarks as CSV, JSON or Markdown.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Harvest X",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}